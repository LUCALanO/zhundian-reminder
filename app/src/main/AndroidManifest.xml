<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 通知横幅（Android 13+ 运行时权限） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 振动：到点强制震动，绕过系统通知震动设置 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 响铃：MediaPlayer 播放时持唤醒锁，深睡/Doze 下尽量不被掐断（normal 权限自动授予） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 悬浮窗：到点在屏幕上方弹出提醒（需用户手动授予「显示在其他应用上层」） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 开机后恢复闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 精确闹钟：闹钟类应用合规，Android 13+ 安装时自动授予 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 常驻前台服务：保活 + 进程内计时，保证国产 ROM 上提醒仍能触发 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 电池优化白名单（引导式授权） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 读取系统日历日程（运行时权限，同步系统日历到本 App 日程提醒） -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application
        android:name=".IntervalReminderApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IntervalReminder">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.IntervalReminder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 通知栏「完成 / 再隔 1 小时提醒」动作 -->
        <receiver
            android:name=".alarm.ActionReceiver"
            android:exported="false" />

        <service
            android:name=".service.ReminderService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the app process alive and runs an in-process scheduler plus exact-alarm backup so interval reminders fire on time, including on OEM ROMs that kill background processes." />
        </service>
    </application>

</manifest>
